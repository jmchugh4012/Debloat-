rules_version = '2';
// Who can do what on JMbets:
//  - Anyone, signed in or not, can read bets, the bio, follower counts and tails.
//  - Only accounts listed in /admins (you) can post, edit, grade or delete bets and change the bio.
//  - A signed-in follower can only write their own follow/tail record and public profile.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }

    match /bets/{betId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /meta/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /fans/{uid} {
      allow read: if true;
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['following', 'tails', 'since'])
        && request.resource.data.following is bool
        && request.resource.data.tails is map
        && request.resource.data.tails.size() <= 500;
      allow delete: if isSelf(uid);
    }
    match /users/{uid} {
      allow read: if true;
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['name', 'photo'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.photo is string && request.resource.data.photo.size() <= 1000;
      allow delete: if isSelf(uid);
    }
    // You add yourself here once, by hand, in the Firebase console. The site can only check itself.
    match /admins/{uid} {
      allow read: if isSelf(uid);
      allow write: if false;
    }
  }
}
